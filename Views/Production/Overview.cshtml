@{
    ViewData["Title"] = "Production Overview";
}

<h1>Production Overview</h1>

<form id="filterForm">
    <label>
        Start Date:
        <input type="date" id="startDate" />
    </label>

    <label>
        End Date:
        <input type="date" id="endDate" />
    </label>

    

    <label>
    Machine:
    <select id="machineSelect">
        <option value="">All machines</option>
    </select>
</label>
    <button type="submit">Show</button>

</form>

<hr />

<table class="table" id="timeEntriesTable">
    <thead>
        <tr>
            <th>Product</th>
            <th>Machine</th>
            <th>Status</th>
            <th>Start</th>
            <th>End</th>
        </tr>
    </thead>
    <tbody>
        <!-- JS füllt das -->
    </tbody>
</table>





<h2>Time Distribution</h2>

<canvas id="timeChart" width="400" height="200"></canvas>

<h2>Analysis (Production vs Downtime)</h2>

<div>
    <strong>Production:</strong> <span id="prodMinutes"></span> min<br />
    <strong>Downtime:</strong> <span id="downMinutes"></span> min<br />
    <strong>Downtime %:</strong> <span id="downPercent"></span>
</div>
<canvas id="analysisChart" height="120"></canvas>


<hr />

<section class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>🤖 Production Insights</span>
        <button type="button"
                class="btn btn-sm btn-outline-primary"
                id="runInsightBtn">
            Analyse erzeugen
        </button>
    </div>

    <div class="card-body">
        <div id="insight-status" class="text-muted">
            Noch keine KI-Analyse ausgeführt.
        </div>
        <pre id="insight-content"
             class="mt-3"
             style="white-space: pre-wrap;"></pre>
    </div>
</section>

<script src="~/lib/chart/chart.umd.js"></script>

<script src="~/js/production.js"></script>